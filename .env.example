# ──────────────────────────────────────────────────────────────
# itto — environment config. Copy to .env and fill in.
# ──────────────────────────────────────────────────────────────

# ── Minecraft server the bot connects to ──
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25565
MC_VERSION=1.20.6
# The username the bot logs in as.
MC_BOT_USERNAME=itto
# "offline" for cracked/LAN dev servers, "microsoft" for real accounts.
MC_AUTH=offline
# Only needed when MC_AUTH=microsoft (leave blank for offline mode).
MC_BOT_EMAIL=
# Username of the human the bot should follow + listen to.
MC_OWNER_USERNAME=

# ── MCP server (what Hermes connects to) ──
# Hermes registers this: `hermes mcp add itto http://localhost:3001`
MCP_PORT=3001
MCP_HOST=0.0.0.0

# ── Model (consumed by Hermes, kept here for local tooling/tests) ──
ANTHROPIC_API_KEY=

# ── Discord (only if we DIY voice instead of Hermes' plugin) ──
# See packages/discord-bridge — disabled by default.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Optional DIY voice pipeline keys:
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Brain: external agent ──
# When true, MC chat/events the bot deems worth reacting to are routed to an
# external agent that drives itto via the itto-mc MCP server (it replies by
# calling the `chat` tool). The agent is invoked as:  <BRAIN_CMD> "<prompt>"
# (prompt appended as the final arg), run in BRAIN_DIR. Any agent that takes a
# prompt as a trailing CLI arg and can reach itto-mc (:3001) works.
# Keep the actual command/path in your local .env (never commit it).
BRAIN_ENABLED=false
# e.g. an agent whose `send <prompt>` runs a model with itto-mc in its MCP config
BRAIN_CMD=
BRAIN_DIR=
# Min ms between agent spawns (each is a full model run).
BRAIN_COOLDOWN_MS=10000

# ── Tuning ──
FAST_LOOP_HZ=15
SLOW_LOOP_INTERVAL_MS=4000
FOLLOW_TARGET_RANGE=3
TELEPORT_FALLBACK_DISTANCE=30
LOG_LEVEL=info
